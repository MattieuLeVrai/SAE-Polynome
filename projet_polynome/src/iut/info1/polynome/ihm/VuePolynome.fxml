<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.chart.*?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="iut.info1.polynome.ihm.ControleurPolynome">
    
    <top>
        <VBox spacing="8">
            <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
            
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Méthode de saisie :"/>
                <ComboBox fx:id="comboTypeSaisie" prefWidth="150" value="Par coefficients">
                    <items>
                        <FXCollections fx:factory="observableArrayList">
                            <String fx:value="Par coefficients"/>
                            <String fx:value="Par racines"/>
                        </FXCollections>
                    </items>
                </ComboBox>
            </HBox>
            
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Valeurs :"/>
                <TextField fx:id="txtCoeffs" promptText="ex: -6 1 1" HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnAjouter" text="Ajouter" onAction="#gererClicAjouter"/>
                <Separator orientation="VERTICAL"/>
                <Button fx:id="btnCharger" text="Charger" onAction="#gererClicCharger"/>
                <Button fx:id="btnSauvegarder" text="Sauvegarder" onAction="#gererClicSauvegarder"/>
            </HBox>
        </VBox>
    </top>

    <left>
        <VBox spacing="10" prefWidth="240">
            <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
            <Label text="Polynômes en mémoire :"/>
            <ListView fx:id="listView" VBox.vgrow="ALWAYS"/>
            <Button text="Supprimer" onAction="#gererClicSupprimer" maxWidth="Infinity"/>
            
            <Separator/>
            <Label text="Informations :"/>
            <GridPane hgap="5" vgap="5">
                <Label text="P(X) =" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <Label fx:id="lblFormule" text="-" GridPane.columnIndex="1" GridPane.rowIndex="0" wrapText="true"/>
                
                <Label text="Degré :" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <Label fx:id="lblDegre" text="-" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                
                <Label text="lim -∞ :" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <Label fx:id="lblLimMoins" text="-" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                
                <Label text="lim +∞ :" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                <Label fx:id="lblLimPlus" text="-" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                
                <Label text="Racines :" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                <Label fx:id="lblRacines" text="-" GridPane.columnIndex="1" GridPane.rowIndex="4" wrapText="true"/>
            </GridPane>
        </VBox>
    </left>

    <center>
        <VBox spacing="10">
            <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
            
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Fenêtre X min :"/>
                <TextField fx:id="txtXMin" text="-10" prefWidth="50"/>
                <Label text="X max :"/>
                <TextField fx:id="txtXMax" text="10" prefWidth="50"/>
                <Button text="Recalculer" onAction="#gererClicRecalculer"/>
            </HBox>

            <LineChart fx:id="lineChart" VBox.vgrow="ALWAYS">
                <xAxis><NumberAxis fx:id="xAxis" label="X"/></xAxis>
                <yAxis><NumberAxis fx:id="yAxis" label="Y"/></yAxis>
            </LineChart>

            <TabPane VBox.vgrow="NEVER" prefHeight="150">
                
                <Tab text="Opérations" closable="false">
                    <VBox spacing="8">
                        <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="P1 :"/>
                            <ComboBox fx:id="comboP1" prefWidth="120"/>
                            <Label text="P2 :"/>
                            <ComboBox fx:id="comboP2" prefWidth="120"/>
                        </HBox>
                        <HBox spacing="5">
                            <Button text="+" onAction="#gererAddition"/>
                            <Button text="-" onAction="#gererSoustraction"/>
                            <Button text="×" onAction="#gererMultiplication"/>
                            <Button text="÷ (Q)" onAction="#gererDivision"/>
                            <Button text="Reste" onAction="#gererReste"/>
                            <Button text="PGCD" onAction="#gererPgcd"/>
                        </HBox>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="Résultat :"/>
                            <Label fx:id="lblResultatOp" text="-"/>
                            <Pane HBox.hgrow="ALWAYS"/>
                            <Button text="Ajouter à la liste" onAction="#gererAjouterResultat"/>
                        </HBox>
                    </VBox>
                </Tab>

                <Tab text="Calculs" closable="false">
                    <VBox spacing="8">
                        <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="Sur P1 :"/>
                            <ComboBox fx:id="comboCalcP1" prefWidth="120"/>
                        </HBox>
                        <HBox spacing="5" alignment="CENTER_LEFT">
                            <Button text="Dérivée" onAction="#gererDerivee"/>
                            <Button text="Primitive" onAction="#gererPrimitive"/>
                            <Separator orientation="VERTICAL"/>
                            <Label text="x ="/>
                            <TextField fx:id="txtValeurX" promptText="x" prefWidth="40"/>
                            <Button text="P(x)" onAction="#gererImage"/>
                            <Separator orientation="VERTICAL"/>
                            <Label text="[a, b] ="/>
                            <TextField fx:id="txtBorneA" promptText="a" prefWidth="40"/>
                            <TextField fx:id="txtBorneB" promptText="b" prefWidth="40"/>
                            <Button text="Intégrale" onAction="#gererIntegrale"/>
                            <Button text="Val. Moyenne" onAction="#gererValeurMoyenne"/>
                        </HBox>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="Résultat :"/>
                            <Label fx:id="lblResultatCalc" text="-"/>
                            <Pane HBox.hgrow="ALWAYS"/>
                            <Button text="Ajouter à la liste" onAction="#gererAjouterResultatCalc"/>
                        </HBox>
                    </VBox>
                </Tab>

                <Tab text="Interpolation" closable="false">
                    <VBox spacing="8">
                        <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
                        <Label text="Points au format (x,y) — Ex: 0,1 1,3 2,7"/>
                        <HBox spacing="10">
                            <TextField fx:id="txtPointsInterp" promptText="0,1 1,3 2,7" HBox.hgrow="ALWAYS"/>
                            <Button text="Interpoler" onAction="#gererInterpolation"/>
                        </HBox>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="Résultat :"/>
                            <Label fx:id="lblResultatInterp" text="-"/>
                            <Pane HBox.hgrow="ALWAYS"/>
                            <Button text="Ajouter à la liste" onAction="#gererAjouterInterp"/>
                        </HBox>
                    </VBox>
                </Tab>
            </TabPane>
        </VBox>
    </center>

    <bottom>
        <HBox>
            <padding><Insets top="5" right="10" bottom="5" left="10"/></padding>
            <Label fx:id="lblStatut" text="Prêt."/>
        </HBox>
    </bottom>
</BorderPane>